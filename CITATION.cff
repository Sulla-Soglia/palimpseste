cff-version: 1.2.0
title: "palimpseste: detecting cultural strata in Alsace-Lorraine architecture"
message: "If you use this software or its data pipeline, please cite it."
type: software
authors:
  - given-names: Zhihan
    family-names: Luo
    alias: "Claudesève Lunélys Velorien"
    orcid: "https://orcid.org/0009-0009-0977-1470"
  - given-names: "Chen Ying"
    family-names: Claude
    alias: "沉映 / Claude Velorien"
